              "const response = pm.response.json();\r",
              "\r",
              "if (pm.response.code === 200 && response.data?.token) {\r",
              "    pm.collectionVariables.set(\"token\", response.data.token);\r",
              "    console.log(\"JWT token saved!\");\r",
              "} else {\r",
              "    pm.collectionVariables.unset(\"token\");\r",
              "    console.log(\"Login failed - token removed.\");\r",
